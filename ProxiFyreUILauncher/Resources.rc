#include "resource.h"
#include <windows.h>

IDI_PROXIFYRE_ICON ICON "..\\assets\\ProxiFyre.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "NT KERNEL\0"
      VALUE "FileDescription", "ProxiFyre UI native integrity host\0"
      VALUE "FileVersion", PROXIFYRE_VERSION_STRING "\0"
      VALUE "InternalName", "ProxiFyreUI\0"
      VALUE "OriginalFilename", "ProxiFyreUI.exe\0"
      VALUE "ProductName", "ProxiFyre\0"
      VALUE "ProductVersion", PROXIFYRE_VERSION_STRING "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
